EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 后端地址在运行时自动推断（见 src/lib/api.ts），一般不用设：
#   Metro 是 10.0.2.2:8081（Android 模拟器）  → 后端 http://10.0.2.2:8000
#   Metro 是 192.168.x.x:8081（真机连局域网） → 后端 http://192.168.x.x:8000
#   Metro 是 127.0.0.1:8081（USB + adb reverse）→ 后端 http://127.0.0.1:8000
# 只有后端不在「Metro 那台机器的 8000 端口」时，才取消下一行注释自己指定。
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000/api